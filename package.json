{
  "name": "frameforge-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first desktop studio for AI video generation: bring your own API keys, compose with HyperFrames, render with FFmpeg.",
  "author": "Quantocos",
  "license": "UNLICENSED",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "pnpm typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "smoke:job": "node scripts/smoke-job.mjs",
    "docs:pdf": "node scripts/md-to-pdf.mjs",
    "docs:check": "node scripts/verify-pdf.mjs docs/FrameForge-Studio-Guide.pdf",
    "package": "pnpm build && electron-builder --dir",
    "dist": "pnpm build && electron-builder"
  },
  "dependencies": {
    "@napi-rs/keyring": "2.1.2",
    "officecli": "0.2.121",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@hyperframes/player": "0.9.30",
    "@hyperframes/studio": "0.9.30",
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^22.10.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "lucide-react": "^0.545.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.7.3",
    "vite": "^5.4.14",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "build": {
    "appId": "com.quantocos.frameforge",
    "productName": "FrameForge Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/@napi-rs/keyring*/**",
      "**/node_modules/officecli/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png",
      "signAndEditExecutable": false,
      "artifactName": "FrameForge-Studio-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FrameForge Studio",
      "artifactName": "FrameForge-Studio-${version}-Setup.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.video"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo"
    }
  }
}
